# GEMINI_API_KEY: Optional Gemini API key if using Google Gemini directly
# Users configure this via the Secrets panel in the AI Studio UI.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENROUTER_API_KEY: Default AI key for OpenRouter (supports multimodal vision & chat)
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
